# Fill in from Supabase → Project Settings → API. Never commit the real file.
#
# Copy to .env.production.local: local builds (`npm run build`, `npm run preview`) get login and sync, while
# `npm run dev` runs offline with demo data and never touches the real database (user, 2026-11-09).
# To test login on the dev server too, copy it to .env.development.local instead.
# Vercel has its own copy under Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
